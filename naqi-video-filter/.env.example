# Copy to .env for local dev. Never commit real secrets (SPEC §11).
DATABASE_URL=postgresql://naqi:naqi@localhost:5432/naqi
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (buckets: uploads, mezzanine, analysis, renders)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=naqi
S3_SECRET_KEY=naqi-secret
S3_REGION=us-east-1

# Signed media URL TTL in seconds (short-lived, per SPEC §8.1)
MEDIA_URL_TTL=900

# Retention (days) — user-configurable downward (SPEC §11)
RETENTION_ORIGINALS_DAYS=30
RETENTION_RENDERS_DAYS=14

# Analysis
PIPELINE_MODEL=mock          # mock | nsfw+nudenet+siglip (M1)
RULES_PATH=./rules.yaml
