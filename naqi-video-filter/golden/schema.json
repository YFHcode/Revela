{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Naqi golden set",
  "description": "Ground-truth clips/films for evaluation (SPEC §12).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["video_id", "duration_s", "shots", "truth"],
    "properties": {
      "video_id": { "type": "string", "minLength": 1 },
      "source": { "type": "string", "description": "Title + timecode; never commit the media itself." },
      "duration_s": { "type": "number", "exclusiveMinimum": 0 },
      "guide_version": { "type": "string" },
      "annotators": { "type": "array", "items": { "type": "string" } },
      "shots": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["idx", "start_s", "end_s"],
          "properties": {
            "idx": { "type": "integer", "minimum": 0 },
            "start_s": { "type": "number", "minimum": 0 },
            "end_s": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      },
      "detections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["shot_idx", "category", "score"],
          "properties": {
            "shot_idx": { "type": "integer", "minimum": 0 },
            "category": { "enum": ["C1", "C2", "C3", "C4", "C5", "C6"] },
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "model": { "type": "string" },
            "model_version": { "type": "string" },
            "sampled_fps": { "type": "number" }
          }
        }
      },
      "truth": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["category", "start_s", "end_s"],
          "properties": {
            "category": { "enum": ["C1", "C2", "C3", "C4", "C5", "C6"] },
            "start_s": { "type": "number", "minimum": 0 },
            "end_s": { "type": "number", "exclusiveMinimum": 0 },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}
